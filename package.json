{
  "name": "chef-2-home-mobile",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:prod": "NODE_ENV=production expo start --dev-client",
    "start:prod:release": "NODE_ENV=production expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:debug": "expo run:ios --configuration Debug",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:simulator": "eas build --platform ios --profile production-simulator",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "version:update": "node scripts/update-mobile-versions.mjs",
    "version:update:dry-run": "node scripts/update-mobile-versions.mjs --dry-run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.5",
    "dayjs": "^1.11.19",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.14",
    "expo-status-bar": "~3.0.9",
    "lottie-react-native": "^7.3.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.0",
    "react-native-paystack-webview": "^5.0.3",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-webview": "^13.16.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^16.28.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

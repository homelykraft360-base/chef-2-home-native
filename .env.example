# API base URL (no trailing slash). For local API:
# - iOS Simulator: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Physical device: http://YOUR_COMPUTER_IP:8000 (e.g. http://192.168.1.5:8000)
EXPO_PUBLIC_BASE_URL=https://your-api.example.com
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Google Sign-In (optional). Use Web OAuth client ID from Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxx.apps.googleusercontent.com
# iOS URL scheme = reversed iOS client ID (e.g. com.googleusercontent.apps.123456789-xxx)
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-xxx

# Expo Push Notifications: optional locally — after `eas init`, Expo injects project ID on EAS builds.
# For simulator/device push debugging against your Expo project:
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# EAS Build / Submit (cloud): add EXPO_PUBLIC_* (and Paystack/Google secrets if needed) as
# Environment variables or Secrets on https://expo.dev → Project → Environment variables.
# `.env` is not uploaded with `eas build`; configure secrets there for production CI builds.

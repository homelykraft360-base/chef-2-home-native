# API base URL (no trailing slash). For local API:
# - iOS Simulator: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Physical device: http://YOUR_COMPUTER_IP:8000 (e.g. http://192.168.1.5:8000)
EXPO_PUBLIC_BASE_URL=https://your-api.example.com
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Google Sign-In (optional). Use Web OAuth client ID from Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxx.apps.googleusercontent.com
# iOS URL scheme = reversed iOS client ID (e.g. com.googleusercontent.apps.123456789-xxx)
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-xxx

# Firebase Cloud Messaging (mobile)
#
# Local dev: put at project root (gitignored):
#   google-services.json, GoogleService-Info.plist
#
# EAS Build does NOT receive gitignored files — it only uploads tracked files. Either:
#   (A) Commit those files (many teams do; keys are client-side), or
#   (B) Add File-type env vars on expo.dev (same names as below) for preview + production.
#
# app.config.js reads file PATHS from env when set (EAS File vars = path on the builder):
#   GOOGLE_SERVICES_JSON
#   GOOGLE_SERVICE_INFO_PLIST
#
# eas.json sets build.environment to "preview" / "production" so those variables apply.
# Create variables: Project → Environment variables → Add variable → Type: File
#
# Docs: https://docs.expo.dev/eas/environment-variables/manage/#secrets-and-file-variables

# Optional local overrides if files live outside the project root:
# GOOGLE_SERVICES_JSON=./secrets/google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./secrets/GoogleService-Info.plist

# EAS Build / Submit (cloud): add EXPO_PUBLIC_* on expo.dev for each environment as needed.
# `.env` is not uploaded with `eas build`.

# EAS project id (optional, for other Expo services):
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
